---
import type { SiteContent } from '../content/types';

interface Props {
  content: SiteContent;
}
const { projects, lang } = Astro.props.content;
const newTab = lang === 'en' ? 'opens in a new tab' : 'abre em nova aba';
---

<section id="work" aria-labelledby="work-title">
  <h2 id="work-title" class="section-title">{projects.heading}</h2>
  <p class="intro">{projects.intro}</p>
  <div class="cases">
    {
      projects.items.map((p) => {
        const [lead, ...rest] = p.outcome;
        return (
          <article class="case" id={`case-${p.id}`} aria-labelledby={`case-${p.id}-title`}>
            <header class="aside">
              <h3 id={`case-${p.id}-title`}>{p.title}</h3>
              <p class="tagline">{p.tagline}</p>
              <dl class="facts">
                <div>
                  <dt class="visually-hidden">{lang === 'en' ? 'Client' : 'Cliente'}</dt>
                  <dd>{p.client}</dd>
                </div>
                <div>
                  <dt class="visually-hidden">{lang === 'en' ? 'Period' : 'Período'}</dt>
                  <dd>{p.period}</dd>
                </div>
                <div>
                  <dt class="visually-hidden">{lang === 'en' ? 'Role' : 'Cargo'}</dt>
                  <dd>{p.role}</dd>
                </div>
                <div>
                  <dt class="visually-hidden">{lang === 'en' ? 'Industry' : 'Setor'}</dt>
                  <dd>{projects.domainLabels[p.domain]}</dd>
                </div>
              </dl>
              {p.links.length > 0 && (
                <ul class="links">
                  {p.links.map((l) => (
                    <li>
                      <a class="text-link" href={l.href} target="_blank" rel="noopener">
                        {l.label}
                        <span class="visually-hidden"> ({newTab})</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </header>

            <div class="main">
              <div class="outcome">
                <h4>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 17l6-6 4 4 8-8" />
                    <path d="M15 7h6v6" />
                  </svg>
                  {projects.outcomeLabel}
                </h4>
                <p class="lead">{lead}</p>
                {rest.map((o) => (
                  <p class="more">{o}</p>
                ))}
              </div>

              <div class="block">
                <h4>{projects.contextLabel}</h4>
                <p>{p.context}</p>
              </div>

              <div class="block">
                <h4>{projects.contributionsLabel}</h4>
                <ul>
                  {p.contributions.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              </div>

              <p class="stack">
                <span>{projects.builtWithLabel}:</span> {p.stack.join(', ')}
              </p>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .intro {
    margin: -16px 0 16px;
    color: var(--muted);
    max-width: 62ch;
  }
  .case {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: 24px 48px;
    padding-block: 44px;
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .case:last-child {
    padding-bottom: 0;
  }

  /* Left column: identity of the project, sticky while its text scrolls past. */
  .aside {
    display: grid;
    gap: 10px;
    align-content: start;
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }
  h3 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }
  .tagline {
    font-weight: 500;
    line-height: 1.45;
  }
  .facts {
    display: grid;
    gap: 2px;
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .facts dd {
    margin: 0;
  }
  .links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 4px;
    margin-top: 8px;
    font-size: 0.92rem;
  }

  /* Right column */
  .main {
    display: grid;
    gap: 24px;
    min-width: 0;
  }
  h4 {
    margin: 0 0 6px;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .outcome {
    display: grid;
    gap: 6px;
    padding: 20px 24px 22px;
    border-radius: 14px;
    background: var(--soft);
  }
  .outcome h4 {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
  }
  .outcome svg {
    width: 16px;
    height: 16px;
  }
  .lead {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }
  .more {
    color: var(--fg);
    opacity: 0.85;
  }
  .block {
    max-width: 62ch;
  }
  .block ul {
    display: grid;
    gap: 8px;
    padding-left: 1.1em;
  }
  .block li::marker {
    color: var(--muted);
  }
  .stack {
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 62ch;
  }
  .stack > span {
    color: var(--fg);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .case {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 36px;
    }
    .aside {
      position: static;
    }
    .facts {
      display: flex;
      flex-wrap: wrap;
      gap: 2px 0;
    }
    .facts > div + div::before {
      content: '';
      display: inline-block;
      width: 1px;
      height: 0.9em;
      margin: 0 10px;
      vertical-align: -1px;
      background: var(--line);
    }
    .links {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 18px;
    }
    .outcome {
      padding: 18px 18px 20px;
    }
  }
</style>
